{
  "id": "weebcentral",
  "name": "Weeb Central",
  "version": 2,
  "base": "https://weebcentral.com",
  "hosts": [
    "weebcentral.com",
    "temp.compsci88.com",
    "scans-hot.planeptune.us",
    "planeptune.us"
  ],
  "endpoints": {
    "popular": {
      "path": "/search/data",
      "vars": {
        "offset": {
          "from": "page",
          "minus": 1,
          "times": 32
        }
      },
      "query": {
        "limit": "32",
        "offset": "{{offset}}",
        "sort": "Popularity",
        "order": "Descending",
        "display_mode": "Minimal Display"
      },
      "parse": {
        "type": "html",
        "list": "article",
        "fields": {
          "id": {
            "selector": "a",
            "attr": "href",
            "transform": [
              {
                "regex": "/series/([^/]+)"
              }
            ]
          },
          "title": {
            "selector": "h2"
          },
          "cover": {
            "template": "https://temp.compsci88.com/cover/normal/{{id}}.webp"
          }
        }
      }
    },
    "latest": {
      "path": "/search/data",
      "vars": {
        "offset": {
          "from": "page",
          "minus": 1,
          "times": 32
        }
      },
      "query": {
        "limit": "32",
        "offset": "{{offset}}",
        "sort": "Latest Updates",
        "order": "Descending",
        "display_mode": "Minimal Display"
      },
      "parse": {
        "type": "html",
        "list": "article",
        "fields": {
          "id": {
            "selector": "a",
            "attr": "href",
            "transform": [
              {
                "regex": "/series/([^/]+)"
              }
            ]
          },
          "title": {
            "selector": "h2"
          },
          "cover": {
            "template": "https://temp.compsci88.com/cover/normal/{{id}}.webp"
          }
        }
      }
    },
    "search": {
      "path": "/search/data",
      "vars": {
        "offset": {
          "from": "page",
          "minus": 1,
          "times": 32
        }
      },
      "query": {
        "limit": "32",
        "offset": "{{offset}}",
        "text": "{{rawQuery}}",
        "sort": "Best Match",
        "order": "Descending",
        "display_mode": "Minimal Display"
      },
      "parse": {
        "type": "html",
        "list": "article",
        "fields": {
          "id": {
            "selector": "a",
            "attr": "href",
            "transform": [
              {
                "regex": "/series/([^/]+)"
              }
            ]
          },
          "title": {
            "selector": "h2"
          },
          "cover": {
            "template": "https://temp.compsci88.com/cover/normal/{{id}}.webp"
          }
        }
      }
    },
    "series": {
      "path": "/series/{{id}}",
      "parse": {
        "type": "html",
        "fields": {
          "title": {
            "selector": "h1"
          },
          "author": {
            "selector": "a[href*='search?author=']"
          },
          "status": {
            "selector": "a[href*='included_status=']",
            "transform": [
              {
                "lower": true
              }
            ]
          },
          "category": {
            "selector": "a[href*='included_type=']",
            "transform": [
              {
                "lower": true
              }
            ]
          },
          "genres": {
            "selector": "a[href*='included_tag=']",
            "many": true
          },
          "synopsis": {
            "selector": "p.whitespace-pre-wrap"
          },
          "cover": {
            "template": "https://temp.compsci88.com/cover/normal/{{id}}.webp"
          }
        }
      }
    },
    "chapters": {
      "path": "/series/{{id}}/full-chapter-list",
      "parse": {
        "type": "html",
        "list": "div[x-data*='checkNewChapter']",
        "fields": {
          "id": {
            "selector": "a",
            "attr": "href",
            "transform": [
              {
                "regex": "/chapters/([^/?#\"]+)"
              }
            ]
          },
          "name": {
            "selector": "span.grow span"
          },
          "number": {
            "selector": "span.grow span",
            "transform": [
              {
                "regex": "([0-9]+(?:\\.[0-9]+)?)"
              },
              {
                "number": true
              }
            ]
          },
          "publishedAt": {
            "selector": "",
            "attr": "x-data",
            "transform": [
              {
                "regex": "checkNewChapter\\('([^']+)'\\)"
              },
              {
                "date": "iso"
              }
            ]
          }
        },
        "limit": 3000
      }
    },
    "pages": {
      "path": "/chapters/{{chapterId}}/images",
      "query": {
        "is_prev": "False",
        "current_page": "1",
        "reading_style": "long_strip"
      },
      "parse": {
        "type": "html",
        "list": "section#chapter-images img",
        "fields": {
          "url": {
            "selector": "",
            "attr": "src"
          }
        },
        "limit": 400
      }
    }
  }
}
